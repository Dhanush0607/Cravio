# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins if needed
# CLIENT_URLS=https://your-frontend.vercel.app

# Database
MONGO_URI=mongodb://127.0.0.1:27017/cravio?replicaSet=rs0

# Authentication — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Development payment simulator. Must remain false in production.
PAYMENTS_DEV_MODE=true

# Razorpay (optional; online payments use the labelled test mode until configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (optional; local uploads are used when omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Assistant (optional; without a key the assistant answers from live Cravio data)
# Any OpenAI-compatible chat-completions endpoint works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Seed administrator (required for production seeding)
ADMIN_NAME=Cravio Administrator
ADMIN_EMAIL=admin@cravio.dev
ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_DEMO_PASSWORD=DemoCustomer123!
